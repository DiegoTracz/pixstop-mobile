<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Nome do app exibido na Home Screen -->
	<key>CFBundleDisplayName</key>
	<string>Pixelstop</string>
	<key>CFBundleName</key>
	<string>Pixelstop</string>

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- Permissão de câmera para QR Code Scanner -->
	<key>NSCameraUsageDescription</key>
	<string>O Pixelstop usa a câmera para ler o QR Code de convite da sua empresa e o QR Code de check-in na geladeira.</string>

	<!-- Launch Screen: cor de fundo enquanto o app carrega -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackgroundColor</string>
	</dict>
</dict>
</plist>
