// Configuração comum de assinatura.
//
// TEAM_ID é o time Apple (IMMO Tecnologia e Soluções Digitais Ltda.), o mesmo
// dos apps Immo e VistoMais. Ele alimenta o DEVELOPMENT_TEAM do projeto — e
// NÃO entra no bundle ID: o template do KMP o concatenava ali para dar um
// identificador único a cada desenvolvedor de um exemplo, o que aqui produziria
// `com.pixstop.mobileDV6WLH3JBP`.
TEAM_ID=DV6WLH3JBP

PRODUCT_NAME=Pixelstop
PRODUCT_BUNDLE_IDENTIFIER=com.pixstop.mobile

// Espelham app.versionCode / app.versionName do gradle.properties, que é a
// fonte única. Mudam no mesmo commit — no immo os dois lugares
// dessincronizaram e a loja ficou à frente da tela "Sobre".
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=0.1.0
