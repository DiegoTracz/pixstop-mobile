<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. "development" no build do Xcode; a exportação
	     para a App Store troca para "production" sozinha. -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Hotspot Configuration: deixa o app entrar na rede Pixelstop-Setup
	     da geladeira com NEHotspotConfiguration, sem a pessoa ir aos Ajustes. -->
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
</dict>
</plist>
