<?xml version="1.0" encoding="utf-8"?>
<!--
    Desenvolvimento: HTTP puro só para os endereços abaixo.

    10.0.2.2 é o "localhost" da máquina visto de dentro do emulador. Os demais
    cobrem aparelho físico na mesma rede e o loopback. Fora desta lista, o
    Android continua exigindo TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!--
            O Android não entende faixa de rede aqui: cada endereço é literal.
            10.42.0.1 é o portal da geladeira em modo de configuração, e é
            HTTP puro porque o certificado teria de ser emitido para um
            aparelho sem domínio. Os 192.168.15.x são a bancada deste
            desenvolvimento: o Sail e o agente simulado no PC.
        -->
        <domain includeSubdomains="false">10.42.0.1</domain>
        <domain includeSubdomains="false">192.168.15.157</domain>
        <domain includeSubdomains="false">192.168.15.127</domain>
        <domain includeSubdomains="true">app.pixtop.localhost</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
